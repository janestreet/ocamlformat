type t : immutable_data with (type : value mod portable) u
type t = (type : value mod portable)

type u =
  ( type :
    value
    mod portable
    with t
    with u
    with ( type :
           value
           mod contended many
           with ('a : value mod portable with (type : (bits8 & bits8) mod external_)) u )
           v )
    y

(* Comment attachment *)

type u =
  ( type :
    (* comment *)
    value
    (* a *)
    mod (* b *) portable
    with (* c d *) t
    with u
    with ( type :
           (* f f *)
           value
           mod contended many
           with ('a : value mod portable with (type : (bits8 & bits8) mod external_)) u )
           v )
    y

(* Attributes *)

type u =
  (( type :
     value
     mod portable
     with t
     with (u[@foo])
     with (( type :
             (* f f *)
             value
             mod contended many
             with (('a : value mod portable with (type : (bits8 & bits8) mod external_)) u
                  [@bar]) )
             v
          [@baz]) )
     y
  [@fnord])
