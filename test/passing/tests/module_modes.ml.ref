(* bindings *)

module M : sig
  type t
end @ m =
  M

module M : S @ m = M

module M @ m = M

module M : sig
  type t
end @ m =
  M
[@@a]

module M : S @ m = M [@@a]

module M @ m = M [@@a]

module [@a] M : sig
  type t
end @ m =
  M

module [@a] M : S @ m = M

module [@a] M @ m = M

(* expressions *)

let () =
  let module M : sig
    type t
  end @ m =
    M
  in
  ()

let () =
  let module M : S @ m = M in
  ()

let () =
  let module M @ m = M in
  ()

